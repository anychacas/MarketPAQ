# ─────────────────────────────────────────────────────────────────────────────
# Backend de MarketPAQ — configuración de DESARROLLO LOCAL
#
#   cp .env.example .env
#
# Todos los valores siguientes son marcadores seguros o valores desechables
# de desarrollo. Nada de esto es una credencial real: rellena con tus propios
# valores antes de usar este archivo fuera de tu equipo.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos ────────────────────────────────────────────────────────────
# Coincide con el Postgres de desarrollo de docker-compose.dev.yml (marketpaq/marketpaq).
DATABASE_URL="postgresql://marketpaq:marketpaq@localhost:5432/marketpaq"

# ── Servidor ─────────────────────────────────────────────────────────────────
# Puerto en el que escucha el servidor Fastify. El proxy de desarrollo de Vite apunta a este puerto.
PORT=3000
# Interfaz a la que se enlaza. 0.0.0.0 también acepta conexiones de otros dispositivos.
HOST=0.0.0.0
# development | production. "production" activa los valores predeterminados estrictos de producción.
NODE_ENV=development
# Nivel de detalle del registro: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# ── CORS ─────────────────────────────────────────────────────────────────────
# Origen(es) permitido(s) para el navegador. Usa una lista separada por espacios para varios.
CORS_ORIGIN=http://localhost:5173

# ── Autenticación ────────────────────────────────────────────────────────────
# Secreto usado para firmar los JWT. Usa una cadena aleatoria larga en cualquier despliegue real.
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=dev-only-insecure-secret-change-me

# Lista de correos separados por comas que obtienen acceso completo al backend.
# El seed local crea admin@example.com — mantenlos sincronizados.
ADMIN_EMAILS=admin@example.com

# Omite la validación del JWT en /entities/User/me y PUT /entities/User/me.
# Solo se respeta cuando NODE_ENV no es "production". Solo para pruebas locales.
DEV_BYPASS=0

# ── URLs usadas en correos y enlaces ────────────────────────────────────────
# URL base pública del despliegue — usada para el logotipo y los enlaces en los correos.
MARKETPAQ_PUBLIC_URL=http://localhost:5173
# URL base del frontend — usada para construir el enlace de restablecimiento de contraseña.
FRONTEND_BASE_URL=http://localhost:5173

# ── Archivos subidos ─────────────────────────────────────────────────────────
# Directorio donde se escriben las imágenes subidas (se sirven en /api/uploads/).
# Las rutas relativas se resuelven desde la carpeta del backend; déjalo vacío para
# usar el valor predeterminado (backend/uploads). El directorio se crea automáticamente.
UPLOAD_DIR=uploads

# ── Correo (transaccional) ───────────────────────────────────────────────────
# MAIL_MODE controla qué ocurre con el correo saliente:
#   smtp  (predeterminado) — envía a través del servidor SMTP configurado más abajo.
#   log                    — nunca envía; imprime el correo en el registro del servidor.
#                            Ideal para el desarrollo local: no hace falta una cuenta SMTP.
# Cuando MAIL_MODE=smtp pero faltan las credenciales de abajo, el correo no se
# envía: el envío informa SMTP_NOT_CONFIGURED en el registro (el backend sigue en ejecución).
MAIL_MODE=log

# SMTP de Zoho — solo es necesario cuando MAIL_MODE=smtp. Déjalo vacío para el desarrollo local.
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=
ZOHO_SMTP_PASS=
ZOHO_SMTP_FROM=MarketPAQ <noreply@example.com>
