# ─────────────────────────────────────────────────────────────────────────────
# MarketPAQ backend — LOCAL DEVELOPMENT configuration
#
#   cp .env.example .env
#
# Every value below is a safe placeholder or a throw-away development default.
# Nothing here is a real credential: fill in your own values before using this
# file outside of your machine.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# Matches the dev Postgres in docker-compose.dev.yml (marketpaq/marketpaq).
DATABASE_URL="postgresql://marketpaq:marketpaq@localhost:5432/marketpaq"

# ── Server ───────────────────────────────────────────────────────────────────
# Port the Fastify server listens on. The Vite dev proxy targets this port.
PORT=3000
# Interface to bind. 0.0.0.0 also accepts connections from other devices.
HOST=0.0.0.0
# development | production. "production" enables strict production defaults.
NODE_ENV=development
# Logging verbosity: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# ── CORS ─────────────────────────────────────────────────────────────────────
# Origin(s) allowed by the browser. Use a space-separated list for several.
CORS_ORIGIN=http://localhost:5173

# ── Auth ─────────────────────────────────────────────────────────────────────
# Secret used to sign JWTs. Use a long random string in any real deployment.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=dev-only-insecure-secret-change-me

# Comma-separated list of emails that get full backend access.
# The local seed creates admin@example.com — keep them in sync.
ADMIN_EMAILS=admin@example.com

# Skip the JWT check on /entities/User/me and PUT /entities/User/me.
# Only honoured when NODE_ENV is not "production". Local testing only.
DEV_BYPASS=0

# ── URLs used in emails and links ───────────────────────────────────────────
# Public base URL of the deployment — used for the logo and links in emails.
MARKETPAQ_PUBLIC_URL=http://localhost:5173
# Base URL of the frontend — used to build the password-reset link.
FRONTEND_BASE_URL=http://localhost:5173

# ── Uploads ──────────────────────────────────────────────────────────────────
# Directory where uploaded images are written (served at /api/uploads/).
# Relative paths are resolved from the backend folder; leave it empty to use
# the default (backend/uploads). The directory is created automatically.
UPLOAD_DIR=uploads

# ── Email (transactional) ────────────────────────────────────────────────────
# MAIL_MODE controls what happens with outgoing email:
#   smtp  (default) — send through the SMTP server configured below.
#   log             — never send; print the email to the server log instead.
#                     Ideal for local development: no SMTP account needed.
# When MAIL_MODE=smtp but the credentials below are missing, the email is not
# sent: the send reports SMTP_NOT_CONFIGURED in the log (the backend keeps running).
MAIL_MODE=log

# Zoho SMTP — only needed when MAIL_MODE=smtp. Leave blank for local dev.
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=
ZOHO_SMTP_PASS=
ZOHO_SMTP_FROM=MarketPAQ <noreply@example.com>
