# Variables del frontend (Vite). Copia este archivo a .env.local para el desarrollo local.
# Los valores VITE_* se incrustan al compilar.

# Correos de administrador separados por comas; solo se usan para mostrar la navegación de administración en la interfaz.
# Mantenlos sincronizados con ADMIN_EMAILS del backend (el backend aplica el control de acceso).
# El seed local crea admin@example.com — usa esa cuenta mientras desarrollas.
VITE_ADMIN_EMAILS=admin@example.com

# Número público de contacto de WhatsApp, solo dígitos y con el código de país (p. ej. 5215550000000).
# El enlace del pie de página y el botón flotante de WhatsApp se ocultan cuando está vacío.
VITE_CONTACT_WHATSAPP=

# Solo para el servidor de desarrollo: URL del backend a la que se redirigen por proxy las peticiones de /api.
API_PROXY_TARGET=http://localhost:3000
