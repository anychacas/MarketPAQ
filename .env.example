# Frontend variables (Vite). Copy to .env.local for local development.
# VITE_* values are embedded at build time.

# Comma-separated admin emails; only used to show admin navigation in the UI.
# Keep it in sync with the backend ADMIN_EMAILS (the backend enforces access).
# The local seed creates admin@example.com — use it while developing.
VITE_ADMIN_EMAILS=admin@example.com

# Public WhatsApp contact number, digits only with country code (e.g. 5215550000000).
# The footer link and the floating WhatsApp button are hidden when empty.
VITE_CONTACT_WHATSAPP=

# Dev server only: backend URL that /api requests are proxied to.
API_PROXY_TARGET=http://localhost:3000
